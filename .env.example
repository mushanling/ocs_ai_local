# OpenAI-compatible base URL; /chat/completions is appended automatically.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Official V4.1 Flash API alias (vision supported).
LLM_MODEL=deepseek-flash
LLM_THINKING_MODE=enabled
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=110
LLM_MAX_TOKENS=16384
VISION_ENABLED=true
# Generate a random local token; this is NOT the model API key.
LOCAL_TOKEN=replace-with-a-random-token
PORT=8765
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800
DB_PATH=data/quiz.sqlite3
